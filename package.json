{
    "name": "bianng-backend",
    "version": "1.0.0",
    "description": "Node.js backend with TypeScript, Prisma, and SOLID principles",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --exec ts-node server.ts",
        "build": "tsc",
        "start": "node dist/server.js",
        "prisma:migrate": "prisma migrate dev --name init",
        "prisma:generate": "npx prisma generate --no-engine",
        "prisma:studio": "prisma studio"
    },
    "dependencies": {
        "@prisma/client": "^6.12.0",
        "@prisma/extension-accelerate": "^2.0.2",
        "bcrypt": "^5.1.1",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.6.1",
        "express": "^4.21.2",
        "express-async-errors": "^3.1.1",
        "express-rate-limit": "^8.0.1",
        "express-validator": "^7.2.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "module-alias": "^2.2.3",
        "morgan": "^1.10.1",
        "multer": "^1.4.5-lts.1",
        "swagger-ui-express": "^5.0.1",
        "uuid": "^11.1.0",
        "yup": "^1.4.0"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/express-rate-limit": "^5.1.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/module-alias": "^2.0.4",
        "@types/morgan": "^1.9.10",
        "@types/multer": "^1.4.12",
        "@types/node": "^24.1.0",
        "@types/swagger-ui-express": "^4.1.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/eslint-plugin": "^8.4.0",
        "@typescript-eslint/parser": "^8.4.0",
        "eslint": "^9.10.0",
        "nodemon": "^3.1.4",
        "prisma": "^5.22.0",
        "ts-node": "^10.9.2",
        "ts-node-dev": "^2.0.0",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.8.3"
    }
}
